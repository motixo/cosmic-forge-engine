+/// Independent colors for the desktop's light and dark themes.
+#[derive(Debug, Default, Deserialize, Serialize, Clone, Copy, PartialEq)]
+#[serde(default, deny_unknown_fields)]
+pub struct ForgePanelColors {
+    pub light: Option<[f32; 3]>,
+    pub dark: Option<[f32; 3]>,
+}
+
+impl ForgePanelColors {
+    fn color(self, dark: bool) -> Option<[f32; 3]> {
+        (if dark { self.dark } else { self.light })
+            .filter(|c| c.iter().all(|v| v.is_finite() && (0.0..=1.0).contains(v)))
+    }
+}
