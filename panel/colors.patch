+#[cfg(all(test, feature = "wayland-rs"))]
+mod forge_color_tests {
+    use super::*;
+    #[test]
+    fn colors_follow_the_mode_and_theme_reset() {
+        let mut config = CosmicPanelConfig::default();
+        config.background = CosmicPanelBackground::Color([0.2, 0.2, 0.2]);
+        assert_eq!(config.bg_color_override(false).unwrap()[0], 0.2);
+        config.forge_colors = Some(ForgePanelColors { light: Some([1.0, 0.0, 0.0]), dark: Some([0.0, 0.0, 1.0]) });
+        assert_eq!(config.bg_color_override(false).unwrap()[0], 1.0);
+        assert_eq!(config.bg_color_override(true).unwrap()[2], 1.0);
+        assert_eq!(config.effective_background(), CosmicPanelBackground::ThemeDefault);
+        config.forge_colors.as_mut().unwrap().light = None;
+        assert!(config.bg_color_override(false).is_none());
+        assert!(config.bg_color_override(true).is_some());
+        config.forge_colors.as_mut().unwrap().dark = Some([f32::NAN, 1.0, 0.0]);
+        assert!(config.bg_color_override(true).is_none());
+    }
+}
