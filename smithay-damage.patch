+/// Capture requirements for this paint of a framebuffer effect.
+#[derive(Clone, Copy, Debug, Default)]
+pub struct FramebufferDamagePlan {
+    /// Bounds of the changed backdrop.
+    pub region: Option<Rectangle<i32, Physical>>,
+    /// Only the partial backdrop has been reconstructed for this paint.
+    pub restricted_repaint: bool,
+}
+
+/// Capture plan published to the effect immediately before sampling.
+#[derive(Debug, Default)]
+pub struct FramebufferDamage(pub std::sync::Mutex<FramebufferDamagePlan>);
+
+type BackdropDamageMap = dyn Fn(Rectangle<i32, Physical>) -> Option<(Rectangle<i32, Physical>, bool)> + Send + Sync;
+
+/// Maps changed backdrop pixels to the area affected in a previously captured element.
+#[derive(Default)]
+pub struct FramebufferEffectDamage {
+    previous: std::sync::Mutex<Option<CapturedBackdropDamage>>,
+}
+
+struct CapturedBackdropDamage {
+    commit: CommitCounter,
+    geometry: Rectangle<i32, Physical>,
+    source: Rectangle<f64, BufferCoords>,
+    map: Box<BackdropDamageMap>,
+}
+
+impl FramebufferEffectDamage {
+    /// Updates the map for the successfully captured commit.
+    pub fn set(
+        &self,
+        commit: CommitCounter,
+        geometry: Rectangle<i32, Physical>,
+        source: Rectangle<f64, BufferCoords>,
+        map: impl Fn(Rectangle<i32, Physical>) -> Option<(Rectangle<i32, Physical>, bool)> + Send + Sync + 'static,
+    ) {
+        *self.previous.lock().unwrap() = Some(CapturedBackdropDamage { commit, geometry, source, map: Box::new(map) });
+    }
+
+    /// Discards the map when the capture no longer has a known footprint.
+    pub fn clear(&self) {
+        self.previous.lock().unwrap().take();
+    }
+
+    fn map(
+        &self,
+        commit: CommitCounter,
+        geometry: Rectangle<i32, Physical>,
+        source: Rectangle<f64, BufferCoords>,
+        rect: Rectangle<i32, Physical>,
+    ) -> Option<(Rectangle<i32, Physical>, bool)> {
+        let previous = self.previous.lock().unwrap();
+        let captured = previous.as_ref()?;
+        if captured.commit == commit && captured.geometry == geometry && captured.source == source {
+            return (captured.map)(rect);
+        }
+        None
+    }
+}
+
+impl std::fmt::Debug for FramebufferEffectDamage {
+    fn fmt(&self, fmt: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        fmt.debug_struct("FramebufferEffectDamage").finish_non_exhaustive()
+    }
+}
