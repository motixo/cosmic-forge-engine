+fn blur_layer(
+    renderer: &mut GlesRenderer,
+    content: Size<i32, Buffer>,
+) -> Result<GlesTexture, GlesError> {
+    // A transparent border preserves samples outside the old ping-pong tile.
+    let storage = Size::from((content.w + 2, content.h + 2));
+    let mut texture: GlesTexture = renderer.create_buffer(Fourcc::Abgr8888, storage)?;
+    renderer.with_context(|gl| unsafe {
+        gl.BindTexture(ffi::TEXTURE_2D, texture.tex_id());
+        for parameter in [ffi::TEXTURE_WRAP_S, ffi::TEXTURE_WRAP_T] {
+            gl.TexParameteri(ffi::TEXTURE_2D, parameter, ffi::CLAMP_TO_EDGE as i32);
+        }
+    })?;
+    let mut target = renderer.bind(&mut texture)?;
+    let area = storage.to_logical(1, Transform::Normal).to_physical(1);
+    let mut frame = renderer.render(&mut target, area, Transform::Normal)?;
+    frame.clear(Color32F::TRANSPARENT, &[Rectangle::from_size(area)])?;
+    let _sync = frame.finish()?;
+    drop(target);
+    Ok(texture)
+}
+
+fn pass_damage(
+    damage: Rectangle<i32, Buffer>,
+    full: Size<i32, Buffer>,
+    source_level: usize,
+    target_level: usize,
+    offset: f64,
+) -> Rectangle<i32, Buffer> {
+    let factor = 1 << source_level;
+    let src = full.downscale(factor);
+    let dst = full.downscale(1 << target_level);
+    let bounds = |start: i32, end: i32, source: i32, target: i32, original: i32| {
+        // Include the widest Kawase tap plus the footprint of bilinear filtering.
+        let radius = offset * f64::from(original) / (f64::from(source) * f64::from(factor)) + 2.0;
+        let scale = f64::from(target) / f64::from(source);
+        let lo = (((f64::from(start) - radius) * scale).floor() as i32).clamp(0, target);
+        let hi = (((f64::from(end) + radius) * scale).ceil() as i32).clamp(lo, target);
+        (lo, hi)
+    };
+    let (x1, x2) = bounds(damage.loc.x, damage.loc.x + damage.size.w, src.w, dst.w, full.w);
+    let (y1, y2) = bounds(damage.loc.y, damage.loc.y + damage.size.h, src.h, dst.h, full.h);
+    Rectangle::new(Point::from((x1, y1)), Size::from((x2 - x1, y2 - y1)))
+}
+
+#[allow(clippy::too_many_arguments)]
+fn blur_pass(
+    renderer: &mut GlesRenderer,
+    shader: &GlesTexProgram,
+    full: Size<i32, Buffer>,
+    source: &GlesTexture,
+    target: &mut GlesTexture,
+    source_level: usize,
+    target_level: usize,
+    offset: f64,
+    damage: Rectangle<i32, Buffer>,
+) -> Result<(), GlesError> {
+    let factor = 1 << source_level;
+    let source_area = Rectangle::new(
+        Point::from((i32::from(source_level > 0), i32::from(source_level > 0))),
+        full.downscale(factor),
+    );
+    let target_area = Rectangle::new(
+        Point::from((i32::from(target_level > 0), i32::from(target_level > 0))),
+        full.downscale(1 << target_level),
+    )
+    .to_logical(1, Transform::Normal, &Size::default())
+    .to_physical(1);
+    let storage = source.size();
+    let half_pixel = [
+        0.5 / source_area.size.w as f32 * (full.w as f32 / storage.w as f32),
+        0.5 / source_area.size.h as f32 * (full.h as f32 / storage.h as f32),
+    ];
+    let target_size = target.size().to_logical(1, Transform::Normal).to_physical(1);
+    let mut target = renderer.bind(target)?;
+    let mut frame = renderer.render(&mut target, target_size, Transform::Normal)?;
+    frame.render_texture_from_to(
+        source,
+        source_area.to_f64(),
+        target_area,
+        &[damage.to_logical(1, Transform::Normal, &Size::default()).to_physical(1)],
+        &[Rectangle::from_size(target_area.size)],
+        Transform::Normal,
+        1.0,
+        Some(shader),
+        &[
+            Uniform::new("half_pixel", half_pixel),
+            Uniform::new("offset", (offset / f64::from(factor)) as f32),
+        ],
+    )?;
+    let _sync = frame.finish()?;
+    Ok(())
+}
