+// This attachment belongs to the outer frame. Only sample it in a distinct target.
+fn with_scene_texture(
+    frame: &mut GlesFrame<'_, '_>,
+    texture: &GlesTexture,
+    draw: impl FnOnce(&mut GlesFrame<'_, '_>) -> Result<(), GlesError>,
+) -> Result<(), GlesError> {
+    let keys = [
+        ffi::TEXTURE_MIN_FILTER, ffi::TEXTURE_MAG_FILTER,
+        ffi::TEXTURE_WRAP_S, ffi::TEXTURE_WRAP_T,
+    ];
+    let (active, previous, state) = frame.with_context(|gl| unsafe {
+        let mut active = 0;
+        let mut previous = 0;
+        gl.GetIntegerv(ffi::ACTIVE_TEXTURE, &mut active);
+        gl.ActiveTexture(ffi::TEXTURE1);
+        gl.GetIntegerv(ffi::TEXTURE_BINDING_2D, &mut previous);
+        gl.BindTexture(ffi::TEXTURE_2D, texture.tex_id());
+        let state: [i32; 4] = std::array::from_fn(|i| {
+            let mut value = 0;
+            gl.GetTexParameteriv(ffi::TEXTURE_2D, keys[i], &mut value);
+            gl.TexParameteri(ffi::TEXTURE_2D, keys[i], if i < 2 {
+                ffi::LINEAR as i32
+            } else {
+                ffi::CLAMP_TO_EDGE as i32
+            });
+            value
+        });
+        gl.ActiveTexture(active as u32);
+        (active, previous, state)
+    })?;
+    let result = draw(frame);
+    frame.with_context(|gl| unsafe {
+        gl.ActiveTexture(ffi::TEXTURE1);
+        gl.BindTexture(ffi::TEXTURE_2D, texture.tex_id());
+        for (name, value) in keys.into_iter().zip(state) {
+            gl.TexParameteri(ffi::TEXTURE_2D, name, value);
+        }
+        gl.BindTexture(ffi::TEXTURE_2D, previous as u32);
+        gl.ActiveTexture(active as u32);
+    })?;
+    result
+}
