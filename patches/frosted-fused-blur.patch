+    vec4 sum = texture2D(frosted_tex, coords + vec2(-step.x * 2.0, 0.0));
+    sum += texture2D(frosted_tex, coords + vec2(-step.x, step.y)) * 2.0;
+    sum += texture2D(frosted_tex, coords + vec2(0.0, step.y * 2.0));
+    sum += texture2D(frosted_tex, coords + vec2(step.x, step.y)) * 2.0;
+    sum += texture2D(frosted_tex, coords + vec2(step.x * 2.0, 0.0));
+    sum += texture2D(frosted_tex, coords + vec2(step.x, -step.y)) * 2.0;
+    sum += texture2D(frosted_tex, coords + vec2(0.0, -step.y * 2.0));
+    sum += texture2D(frosted_tex, coords + vec2(-step.x, -step.y)) * 2.0;
+    if (sum.a == 0.0) {
+        return vec4(0.0);
+    }
+    // Match the RGBA8 intermediate that this pass replaces.
+    return floor(clamp(sum / sum.a, 0.0, 1.0) * 255.0 + 0.5) / 255.0;
