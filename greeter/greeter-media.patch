+// SPDX-License-Identifier: GPL-3.0-only
+
+//! Lock-screen-only MPRIS client. No authentication or surface-management actions.
+
+use std::{collections::HashMap, io::Read, process::Stdio, time::Duration};
+
+use cosmic::{
+    Element,
+    iced::{
+        self, Alignment, Length, Subscription,
+        futures::{SinkExt, StreamExt},
+    },
+    widget,
+};
+use tokio::io::{AsyncReadExt, AsyncWriteExt};
+use zbus::{Connection, MatchRule, MessageStream, fdo::DBusProxy, zvariant::OwnedValue};
+
+use crate::fl;
+
+const PATH: &str = "/org/mpris/MediaPlayer2";
+const PLAYER: &str = "org.mpris.MediaPlayer2.Player";
+const PREFIX: &str = "org.mpris.MediaPlayer2.";
+const CALL_TIMEOUT: Duration = Duration::from_secs(2);
+const TRACK_TRANSITION_GRACE: Duration = Duration::from_millis(1500);
+const MAX_ART: u64 = 8 * 1024 * 1024;
+const ART_SIDE: u32 = 128;
+const ART_BYTES: usize = (ART_SIDE * ART_SIDE * 4) as usize;
+
+type Properties = HashMap<String, OwnedValue>;
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct Player {
+    // Address the unique owner: a stale click must never activate/restart another app.
+    pub owner: String,
+    pub name: String,
+    pub title: String,
+    pub artist: String,
+    pub album: String,
+    pub track: String,
+    pub art_url: String,
+    pub playing: bool,
+    pub can_play: bool,
+    pub can_pause: bool,
+    pub can_previous: bool,
+    pub can_next: bool,
+}
+
+#[derive(Clone, Copy, Debug)]
+pub enum Command {
+    Play,
+    Pause,
+    Previous,
+    Next,
+}
+
+impl Command {
+    fn method(self) -> &'static str {
+        match self {
+            Self::Play => "Play",
+            Self::Pause => "Pause",
+            Self::Previous => "Previous",
+            Self::Next => "Next",
+        }
+    }
+
+    fn allowed(self, player: &Player) -> bool {
+        match self {
+            Self::Play => player.can_play,
+            Self::Pause => player.can_pause,
+            Self::Previous => player.can_previous,
+            Self::Next => player.can_next,
+        }
+    }
+}
+
+#[derive(Clone, Debug)]
+pub enum Event {
+    Connected(Connection),
+    Players(Vec<Player>),
+}
+
+#[derive(Clone, Debug)]
+pub enum Message {
+    Update(Event),
+    Control(String, Command),
+    Cycle,
+    Artwork(u64, Option<widget::image::Handle>),
+    Finished,
+}
+
+#[derive(Default)]
+pub struct State {
+    connection: Option<Connection>,
+    players: Vec<Player>,
+    selected: Option<String>,
+    artwork: Option<widget::image::Handle>,
+    art_key: Option<(String, String, String)>,
+    art_generation: u64,
+    art_task: Option<iced::task::Handle>,
+    command_pending: bool,
+}
+
+impl State {
+    fn active(&self) -> Option<&Player> {
+        select(&self.players, self.selected.as_deref())
+    }
+
+    pub fn clear(&mut self) {
+        // Invalidate in-flight artwork across unlock/relock as well as track changes.
+        self.art_generation = self.art_generation.wrapping_add(1);
+        if let Some(task) = self.art_task.take() {
+            task.abort();
+        }
+        self.command_pending = false;
+        self.connection = None;
+        self.players.clear();
+        self.selected = None;
+        self.artwork = None;
+        self.art_key = None;
+    }
+
+    pub fn update(&mut self, message: Message) -> cosmic::app::Task<Message> {
+        match message {
+            Message::Update(Event::Connected(connection)) => self.connection = Some(connection),
+            Message::Update(Event::Players(players)) => {
+                self.players = players;
+                if !self
+                    .players
+                    .iter()
+                    .any(|p| Some(p.owner.as_str()) == self.selected.as_deref())
+                {
+                    self.selected = None;
+                }
+            }
+            Message::Cycle => {
+                if let Some(index) = self
+                    .active()
+                    .and_then(|active| self.players.iter().position(|p| p.owner == active.owner))
+                {
+                    self.selected =
+                        Some(self.players[(index + 1) % self.players.len()].owner.clone());
+                }
+            }
+            Message::Control(owner, command) => {
+                if let (Some(connection), Some(player)) = (self.connection.clone(), self.active()) {
+                    if !self.command_pending && player.owner == owner && command.allowed(player) {
+                        self.command_pending = true;
+                        return cosmic::task::future(async move {
+                            // All failures stay within the media component.
+                            let _ = tokio::time::timeout(
+                                CALL_TIMEOUT,
+                                control(&connection, &owner, command),
+                            )
+                            .await;
+                            Message::Finished
+                        });
+                    }
+                }
+            }
+            Message::Artwork(generation, artwork) => {
+                if generation == self.art_generation {
+                    self.artwork = artwork;
+                }
+            }
+            Message::Finished => self.command_pending = false,
+        }
+        let key = self
+            .active()
+            .map(|p| (p.owner.clone(), p.track.clone(), p.art_url.clone()));
+        if self.art_key != key {
+            self.art_generation = self.art_generation.wrapping_add(1);
+            if let Some(task) = self.art_task.take() {
+                task.abort();
+            }
+            // Keep the decoded cover visible while the next one is being loaded.
+            self.art_key = key.clone();
+            if let Some((_, _, url)) = key.clone().filter(|(_, _, url)| !url.is_empty()) {
+                let generation = self.art_generation;
+                let (task, handle) = cosmic::task::future(async move {
+                    let artwork = tokio::time::timeout(Duration::from_secs(8), artwork(&url))
+                        .await
+                        .ok()
+                        .flatten();
+                    Message::Artwork(generation, artwork)
+                })
+                .abortable();
+                self.art_task = Some(handle);
+                return task;
+            } else if key.is_some() && self.artwork.is_some() {
+                // Metadata can briefly omit artwork between tracks. Replace with the
+                // placeholder only if the next update still has no cover after the grace period.
+                let generation = self.art_generation;
+                let (task, handle) = cosmic::task::future(async move {
+                    tokio::time::sleep(TRACK_TRANSITION_GRACE).await;
+                    Message::Artwork(generation, None)
+                })
+                .abortable();
+                self.art_task = Some(handle);
+                return task;
+            } else {
+                self.artwork = None;
+            }
+        }
+        cosmic::app::Task::none()
+    }
+
+    pub fn view(&self) -> Option<Element<'_, Message>> {
+        let player = self.active()?;
+        Some(
+            widget::responsive(move |size| self.card(player, size.width < 560.0))
+                .height(Length::Shrink)
+                .into(),
+        )
+    }
+
+    fn card<'a>(&'a self, player: &'a Player, compact: bool) -> Element<'a, Message> {
+        use cosmic::theme;
+        use iced::core::text::{Ellipsize, EllipsizeHeightLimit};
+        let cover_size = if compact { 72.0 } else { 88.0 };
+        let cover: Element<'_, Message> = match &self.artwork {
+            Some(handle) => widget::image(handle)
+                .width(cover_size)
+                .height(cover_size)
+                .border_radius(12.0)
+                .content_fit(iced::ContentFit::Cover)
+                .into(),
+            None => widget::container(widget::icon::from_name("audio-x-generic-symbolic").size(32))
+                .width(cover_size)
+                .height(cover_size)
+                .center(cover_size)
+                .class(theme::Container::custom(|theme| {
+                    let mut style =
+                        widget::container::Catalog::style(theme, &theme::Container::Card);
+                    style.border.radius = 12.0.into();
+                    style
+                }))
+                .into(),
+        };
+        let one_line = |value: String| {
+            widget::text(value)
+                .ellipsize(Ellipsize::End(EllipsizeHeightLimit::Lines(1)))
+                .width(Length::Fill)
+        };
+        let title = if player.title.is_empty() {
+            fl!("media-unknown-track")
+        } else {
+            player.title.clone()
+        };
+        let description = if player.artist.is_empty() {
+            player.album.clone()
+        } else {
+            player.artist.clone()
+        };
+        let secondary = theme::Text::Custom(|theme| {
+            let mut color: iced::Color = theme.cosmic().background(theme.transparent).on.into();
+            color.a *= 0.65;
+            iced::widget::text::Style {
+                color: Some(color),
+                ..Default::default()
+            }
+        });
+        let source: Element<'_, Message> = if self.players.len() > 1 {
+            widget::button::custom(
+                widget::row::with_capacity(2)
+                    .spacing(6)
+                    .align_y(Alignment::Center)
+                    .push(
+                        one_line(player.name.clone())
+                            .size(12)
+                            .class(secondary)
+                            .width(Length::Shrink),
+                    )
+                    .push(widget::icon::from_name("pan-down-symbolic").size(12)),
+            )
+            .padding([3, 6])
+            .class(theme::Button::Text)
+            .on_press(Message::Cycle)
+            .into()
+        } else {
+            one_line(player.name.clone())
+                .size(12)
+                .class(secondary)
+                .width(Length::Shrink)
+                .into()
+        };
+        let status = widget::text(if player.playing {
+            fl!("media-playing")
+        } else {
+            fl!("media-paused")
+        })
+        .size(11)
+        .font(cosmic::font::semibold())
+        .class(if player.playing {
+            theme::Text::Accent
+        } else {
+            secondary
+        });
+        let source_row = widget::row::with_capacity(3)
+            .spacing(10)
+            .align_y(Alignment::Center)
+            .push(
+                widget::container(source)
+                    .width(Length::Shrink)
+                    .max_width(190),
+            )
+            .push(widget::text("·").size(12).class(secondary))
+            .push(status);
+        let details = widget::column::with_capacity(3)
+            .spacing(5)
+            .width(Length::Fill)
+            .push(
+                one_line(title)
+                    .size(if compact { 18 } else { 20 })
+                    .font(cosmic::font::semibold())
+                    .line_height(iced::core::text::LineHeight::Absolute(24.0.into())),
+            )
+            .push(
+                one_line(description)
+                    .size(14)
+                    .class(secondary)
+                    .line_height(iced::core::text::LineHeight::Absolute(20.0.into())),
+            )
+            .push(source_row);
+        let button = |icon, label: String, command: Command, primary: bool| {
+            widget::button::icon(widget::icon::from_name(icon))
+                .icon_size(if primary { 24 } else { 20 })
+                .width(if primary { 52 } else { 40 })
+                .height(if primary { 52 } else { 40 })
+                .padding(if primary { 14 } else { 10 })
+                .tooltip(label)
+                .class(if primary {
+                    theme::Button::Suggested
+                } else {
+                    theme::Button::Icon
+                })
+                .on_press_maybe(
+                    (!self.command_pending && command.allowed(player))
+                        .then(|| Message::Control(player.owner.clone(), command)),
+                )
+        };
+        let toggle = if player.playing {
+            Command::Pause
+        } else {
+            Command::Play
+        };
+        let controls = widget::row::with_capacity(3)
+            .spacing(8)
+            .align_y(Alignment::Center)
+            .push(button(
+                "media-skip-backward-symbolic",
+                fl!("media-previous"),
+                Command::Previous,
+                false,
+            ))
+            .push(button(
+                if player.playing {
+                    "media-playback-pause-symbolic"
+                } else {
+                    "media-playback-start-symbolic"
+                },
+                if player.playing {
+                    fl!("media-pause")
+                } else {
+                    fl!("media-play")
+                },
+                toggle,
+                true,
+            ))
+            .push(button(
+                "media-skip-forward-symbolic",
+                fl!("media-next"),
+                Command::Next,
+                false,
+            ));
+        let information = widget::row::with_capacity(2)
+            .width(Length::Fill)
+            .spacing(18)
+            .align_y(Alignment::Center)
+            .push(cover)
+            .push(details);
+        let content: Element<'_, Message> = if compact {
+            widget::column::with_capacity(2)
+                .spacing(18)
+                .push(information)
+                .push(widget::container(controls).center_x(Length::Fill))
+                .into()
+        } else {
+            widget::row::with_capacity(2)
+                .spacing(24)
+                .align_y(Alignment::Center)
+                .push(information)
+                .push(controls)
+                .into()
+        };
+        widget::container(content)
+            .padding(if compact { 16 } else { 20 })
+            .width(Length::Fill)
+            .class(theme::Container::custom(|theme| {
+                let mut style = widget::container::Catalog::style(theme, &theme::Container::Card);
+                style.border.radius = 18.0.into();
+                style.border.width = 1.0;
+                style.border.color = theme
+                    .cosmic()
+                    .background(theme.transparent)
+                    .component
+                    .divider
+                    .into();
+                style
+            }))
+            .into()
+    }
+}
+
+fn select<'a>(players: &'a [Player], selected: Option<&str>) -> Option<&'a Player> {
+    selected
+        .and_then(|id| players.iter().find(|p| p.owner == id))
+        .or_else(|| players.iter().find(|p| p.playing))
+        .or_else(|| players.first())
+}
+
+fn string(map: &Properties, key: &str) -> String {
+    map.get(key)
+        .and_then(|v| <&str>::try_from(v).ok())
+        .unwrap_or_default()
+        .chars()
+        .filter(|c| !c.is_control())
+        .take(512)
+        .collect()
+}
+
+fn boolean(map: &Properties, key: &str) -> bool {
+    map.get(key)
+        .and_then(|v| bool::try_from(v).ok())
+        .unwrap_or(false)
+}
+
+fn parse(owner: String, name: String, mut props: Properties) -> Option<Player> {
+    let status = string(&props, "PlaybackStatus");
+    if status != "Playing" && status != "Paused" {
+        return None;
+    }
+    let can_control = boolean(&props, "CanControl");
+    let metadata = props
+        .remove("Metadata")
+        .and_then(|v| Properties::try_from(v).ok())
+        .unwrap_or_default();
+    let artist = metadata
+        .get("xesam:artist")
+        .and_then(|v| v.try_clone().ok())
+        .and_then(|v| Vec::<String>::try_from(v).ok())
+        .unwrap_or_default()
+        .into_iter()
+        .take(8)
+        .collect::<Vec<_>>()
+        .join(", ")
+        .chars()
+        .filter(|c| !c.is_control())
+        .take(512)
+        .collect();
+    Some(Player {
+        owner,
+        name: name.chars().filter(|c| !c.is_control()).take(128).collect(),
+        title: string(&metadata, "xesam:title"),
+        artist,
+        album: string(&metadata, "xesam:album"),
+        track: metadata
+            .get("mpris:trackid")
+            .and_then(|v| <&zbus::zvariant::ObjectPath<'_>>::try_from(v).ok())
+            .map(ToString::to_string)
+            .unwrap_or_else(|| string(&metadata, "xesam:title")),
+        // URLs are data, never shell commands. Preserve percent encoding and Unicode.
+        art_url: metadata
+            .get("mpris:artUrl")
+            .and_then(|v| <&str>::try_from(v).ok())
+            .filter(|url| url.len() <= 8192)
+            .unwrap_or_default()
+            .to_string(),
+        playing: status == "Playing",
+        can_play: can_control && boolean(&props, "CanPlay"),
+        can_pause: can_control && boolean(&props, "CanPause"),
+        can_previous: can_control && boolean(&props, "CanGoPrevious"),
+        can_next: can_control && boolean(&props, "CanGoNext"),
+    })
+}
+
+async fn read_player(connection: Connection, name: String) -> zbus::Result<Option<Player>> {
+    let bus = DBusProxy::new(&connection).await?;
+    let owner = bus.get_name_owner(name.as_str().try_into()?).await?;
+    let properties = zbus::fdo::PropertiesProxy::builder(&connection)
+        .destination(owner.clone())?
+        .path(PATH)?
+        .build()
+        .await?;
+    let props = properties.get_all(PLAYER.try_into()?).await?;
+    let identity = properties
+        .get("org.mpris.MediaPlayer2".try_into()?, "Identity")
+        .await
+        .ok()
+        .and_then(|v| String::try_from(v).ok())
+        .unwrap_or_else(|| name.trim_start_matches(PREFIX).to_string());
+    Ok(parse(owner.to_string(), identity, props))
+}
+
+async fn control(connection: &Connection, owner: &str, command: Command) -> zbus::Result<()> {
+    // A closed set of methods. Never Raise, OpenUri, Quit, launch a process or unlock.
+    let proxy = zbus::Proxy::new(connection, owner, PATH, PLAYER).await?;
+    proxy.call(command.method(), &()).await
+}
+
+pub fn subscription() -> Subscription<Message> {
+    Subscription::run(|| {
+        iced::stream::channel(8, |mut output| async move {
+            loop {
+                if monitor(&mut output).await.is_err() {
+                    let _ = output
+                        .send(Message::Update(Event::Players(Vec::new())))
+                        .await;
+                }
+                tokio::time::sleep(Duration::from_secs(3)).await;
+            }
+        })
+    })
+}
+
+async fn monitor(output: &mut iced::futures::channel::mpsc::Sender<Message>) -> zbus::Result<()> {
+    let connection = Connection::session().await?;
+    // Subscribe before enumerating to cover players appearing during discovery.
+    let owners = MatchRule::builder()
+        .msg_type(zbus::message::Type::Signal)
+        .sender("org.freedesktop.DBus")?
+        .interface("org.freedesktop.DBus")?
+        .member("NameOwnerChanged")?
+        .arg0ns("org.mpris.MediaPlayer2")?
+        .build();
+    let changes = MatchRule::builder()
+        .msg_type(zbus::message::Type::Signal)
+        .path(PATH)?
+        .interface("org.freedesktop.DBus.Properties")?
+        .member("PropertiesChanged")?
+        .add_arg(PLAYER)?
+        .build();
+    let mut owners = MessageStream::for_match_rule(owners, &connection, Some(64)).await?;
+    let mut changes = MessageStream::for_match_rule(changes, &connection, Some(64)).await?;
+    let bus = DBusProxy::new(&connection).await?;
+    let _ = output
+        .send(Message::Update(Event::Connected(connection.clone())))
+        .await;
+    // Drain both streams concurrently with requests, so signal floods cannot block replies.
+    let (changed, mut receiver) = tokio::sync::watch::channel(());
+    let signals = async move {
+        loop {
+            let item = tokio::select! {
+                item = owners.next() => item,
+                item = changes.next() => item,
+            };
+            match item {
+                Some(Ok(_)) => {
+                    changed.send_replace(());
+                }
+                Some(Err(error)) => return Err(error),
+                None => return Err(zbus::Error::Failure("MPRIS bus disconnected".into())),
+            }
+        }
+    };
+    let snapshots = async {
+        let mut last: Option<Vec<Player>> = None;
+        let mut missing_since = HashMap::new();
+        loop {
+            let names = bus.list_names().await?;
+            let mut players: Vec<Player> = futures_util::stream::iter(
+                names
+                    .into_iter()
+                    .filter(|name| name.starts_with(PREFIX))
+                    .take(64),
+            )
+            .map(|name| {
+                let connection = connection.clone();
+                async move {
+                    tokio::time::timeout(CALL_TIMEOUT, read_player(connection, name.to_string()))
+                        .await
+                }
+            })
+            .buffer_unordered(8)
+            .filter_map(|result| async { result.ok().and_then(Result::ok).flatten() })
+            .collect()
+            .await;
+            // Some players report Stopped or fail a property request while advancing
+            // a track. Retain the last snapshot briefly, but remove closed owners immediately.
+            let now = tokio::time::Instant::now();
+            let mut waiting = HashMap::new();
+            if let Some(previous) = &last {
+                for old in previous {
+                    if players.iter().any(|p| p.owner == old.owner) {
+                        continue;
+                    }
+                    let since = missing_since.get(&old.owner).copied().unwrap_or(now);
+                    if now.duration_since(since) < TRACK_TRANSITION_GRACE
+                        && bus
+                            .name_has_owner(old.owner.as_str().try_into()?)
+                            .await
+                            .unwrap_or(false)
+                    {
+                        waiting.insert(old.owner.clone(), since);
+                        players.push(old.clone());
+                    }
+                }
+            }
+            missing_since = waiting;
+            players.sort_by(|a, b| a.name.cmp(&b.name).then(a.owner.cmp(&b.owner)));
+            let mut seen = std::collections::HashSet::new();
+            players.retain(|p| seen.insert(p.owner.clone()));
+            if last.as_ref() != Some(&players) {
+                last = Some(players.clone());
+                output
+                    .send(Message::Update(Event::Players(players)))
+                    .await
+                    .map_err(|_| zbus::Error::Failure("MPRIS subscription ended".into()))?;
+            }
+            let next_expiry = missing_since
+                .values()
+                .map(|since| *since + TRACK_TRANSITION_GRACE)
+                .min();
+            if let Some(expiry) = next_expiry {
+                tokio::select! {
+                    changed = receiver.changed() => changed.map_err(|_| zbus::Error::Failure("MPRIS bus disconnected".into()))?,
+                    _ = tokio::time::sleep_until(expiry) => {},
+                }
+            } else {
+                receiver
+                    .changed()
+                    .await
+                    .map_err(|_| zbus::Error::Failure("MPRIS bus disconnected".into()))?;
+            }
+            tokio::time::sleep(Duration::from_millis(100)).await;
+            // Coalesce pending changes; changes during the next scan remain pending.
+            receiver.borrow_and_update();
+        }
+        #[allow(unreachable_code)]
+        Ok::<(), zbus::Error>(())
+    };
+    let result: zbus::Result<((), ())> = tokio::try_join!(signals, snapshots);
+    result.map(|_| ())
+}
