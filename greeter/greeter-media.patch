+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn player(owner: &str, playing: bool) -> Player {
+        Player {
+            owner: owner.into(),
+            name: owner.into(),
+            title: String::new(),
+            artist: String::new(),
+            album: String::new(),
+            track: String::new(),
+            art_url: String::new(),
+            playing,
+            can_play: true,
+            can_pause: true,
+            can_previous: false,
+            can_next: false,
+        }
+    }
+
+    #[test]
+    fn prefers_playing_but_preserves_explicit_selection_and_paused_player() {
+        let players = [player(":1.1", false), player(":1.2", true)];
+        assert_eq!(select(&players, None).unwrap().owner, ":1.2");
+        assert_eq!(select(&players, Some(":1.1")).unwrap().owner, ":1.1");
+        assert_eq!(select(&players[..1], Some(":1.9")).unwrap().owner, ":1.1");
+        assert!(select(&[], None).is_none());
+    }
+
+    #[test]
+    fn malformed_or_missing_capabilities_never_enable_controls() {
+        let mut props = Properties::new();
+        props.insert(
+            "PlaybackStatus".into(),
+            zbus::zvariant::Value::from("Playing").try_into().unwrap(),
+        );
+        props.insert("CanPlay".into(), true.into());
+        props.insert(
+            "CanPause".into(),
+            zbus::zvariant::Value::from("true").try_into().unwrap(),
+        );
+        let p = parse(":1.1".into(), "test".into(), props).unwrap();
+        assert!(!Command::Play.allowed(&p));
+        assert!(!Command::Pause.allowed(&p));
+        assert!(!Command::Next.allowed(&p));
+        assert!(!Command::Previous.allowed(&p));
+    }
+
+    #[test]
+    fn clearing_state_invalidates_artwork_and_selection() {
+        let mut state = State {
+            players: vec![player(":1.1", true)],
+            selected: Some(":1.1".into()),
+            ..State::default()
+        };
+        let generation = state.art_generation;
+        state.clear();
+        assert!(state.active().is_none());
+        assert!(state.connection.is_none());
+        assert!(state.art_generation != generation);
+    }
+}
