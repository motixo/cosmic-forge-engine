+async fn artwork(location: &str) -> Option<widget::image::Handle> {
+    let url = url::Url::parse(location).ok()?;
+    if !url.username().is_empty() || url.password().is_some() {
+        return None;
+    }
+    let bytes = match url.scheme() {
+        "file" => {
+            let path = url.to_file_path().ok()?;
+            tokio::task::spawn_blocking(move || {
+                use std::os::unix::fs::OpenOptionsExt;
+                // Reject devices, FIFOs and final symlinks; inspect the opened file to avoid races.
+                let file = std::fs::OpenOptions::new()
+                    .read(true)
+                    .custom_flags(libc::O_NONBLOCK | libc::O_NOFOLLOW)
+                    .open(path)
+                    .ok()?;
+                let metadata = file.metadata().ok()?;
+                if !metadata.is_file() || metadata.len() > MAX_ART {
+                    return None;
+                }
+                let mut bytes = Vec::new();
+                file.take(MAX_ART + 1).read_to_end(&mut bytes).ok()?;
+                (bytes.len() <= MAX_ART as usize).then_some(bytes)
+            })
+            .await
+            .ok()??
+        }
+        "https" | "http" => {
+            let mut child = tokio::process::Command::new("/usr/bin/curl")
+                // Ignore .curlrc, URL globbing, other protocols and excessive redirects/data/time.
+                .args([
+                    "--disable",
+                    "--globoff",
+                    "--silent",
+                    "--fail",
+                    "--location",
+                    "--max-redirs",
+                    "3",
+                    "--proto",
+                    "=https,http",
+                    "--proto-redir",
+                    "=https,http",
+                    "--connect-timeout",
+                    "2",
+                    "--max-time",
+                    "5",
+                    "--max-filesize",
+                    "8388608",
+                    "--url",
+                    url.as_str(),
+                ])
+                .stdin(Stdio::null())
+                .stdout(Stdio::piped())
+                .stderr(Stdio::null())
+                .kill_on_drop(true)
+                .spawn()
+                .ok()?;
+            let mut bytes = Vec::new();
+            child
+                .stdout
+                .take()?
+                .take(MAX_ART + 1)
+                .read_to_end(&mut bytes)
+                .await
+                .ok()?;
+            if bytes.len() > MAX_ART as usize {
+                return None;
+            }
+            if !child.wait().await.ok()?.success() {
+                return None;
+            }
+            bytes
+        }
+        _ => return None,
+    };
+    // Decode in a separate, resource-limited process. The locker receives fixed-size RGBA,
+    // never a compressed image or native AVIF decoder input from an MPRIS client.
+    // The sandbox has no network, home directory, host /tmp or session sockets.
+    // If bubblewrap/user namespaces are unavailable, keep the placeholder; never decode in-process.
+    let executable = std::env::current_exe().ok()?;
+    let mut command = tokio::process::Command::new("/usr/bin/bwrap");
+    command
+        .args([
+            "--unshare-all",
+            "--die-with-parent",
+            "--new-session",
+            "--cap-drop",
+            "ALL",
+            "--ro-bind",
+            "/usr",
+            "/usr",
+            "--ro-bind",
+            "/lib",
+            "/lib",
+            "--ro-bind",
+            "/lib64",
+            "/lib64",
+            "--ro-bind",
+        ])
+        .arg(executable)
+        .args([
+            "/veil-art-decoder",
+            "--proc",
+            "/proc",
+            "--dev",
+            "/dev",
+            "--tmpfs",
+            "/tmp",
+            "--chdir",
+            "/",
+            "/veil-art-decoder",
+            "--veil-decode-art",
+        ])
+        .env_clear()
+        .env("RAYON_NUM_THREADS", "1")
+        .stdin(Stdio::piped())
+        .stdout(Stdio::piped())
+        .stderr(Stdio::null())
+        .kill_on_drop(true);
+    // SAFETY: pre_exec performs only async-signal-safe libc calls and constructs no heap values.
+    unsafe {
+        command.pre_exec(|| {
+            let memory = libc::rlimit {
+                rlim_cur: 1024 * 1024 * 1024,
+                rlim_max: 1024 * 1024 * 1024,
+            };
+            let cpu = libc::rlimit {
+                rlim_cur: 3,
+                rlim_max: 3,
+            };
+            if libc::setrlimit(libc::RLIMIT_AS, &memory) != 0
+                || libc::setrlimit(libc::RLIMIT_CPU, &cpu) != 0
+                || libc::prctl(libc::PR_SET_NO_NEW_PRIVS, 1, 0, 0, 0) != 0
+            {
+                return Err(std::io::Error::last_os_error());
+            }
+            Ok(())
+        });
+    }
+    let mut child = command.spawn().ok()?;
+    let mut input = child.stdin.take()?;
+    let output = child.stdout.take()?;
+    let mut pixels = Vec::with_capacity(ART_BYTES);
+    let write = async move {
+        input.write_all(&bytes).await?;
+        // ChildStdin::shutdown does not close Unix pipes: drop it to deliver EOF.
+        drop(input);
+        Ok::<(), std::io::Error>(())
+    };
+    let read = async {
+        output
+            .take(ART_BYTES as u64 + 1)
+            .read_to_end(&mut pixels)
+            .await
+    };
+    tokio::try_join!(write, read).ok()?;
+    if pixels.len() != ART_BYTES || !child.wait().await.ok()?.success() {
+        return None;
+    }
+    Some(widget::image::Handle::from_rgba(ART_SIDE, ART_SIDE, pixels))
+}
+
+/// Private child-process entry point: no D-Bus, Wayland, PAM, or session setup.
+pub fn decode_artwork() -> Option<()> {
+    use std::io::Write;
+    let mut bytes = Vec::new();
+    std::io::stdin()
+        .take(MAX_ART + 1)
+        .read_to_end(&mut bytes)
+        .ok()?;
+    if bytes.len() > MAX_ART as usize {
+        return None;
+    }
+    let format = image::guess_format(&bytes).ok()?;
+    if !matches!(
+        format,
+        image::ImageFormat::Png | image::ImageFormat::Jpeg | image::ImageFormat::WebP
+    ) {
+        return None;
+    }
+    let mut reader = image::ImageReader::with_format(std::io::Cursor::new(bytes), format);
+    let mut limits = image::Limits::default();
+    limits.max_image_width = Some(4096);
+    limits.max_image_height = Some(4096);
+    limits.max_alloc = Some(64 * 1024 * 1024);
+    reader.limits(limits);
+    let image = reader
+        .decode()
+        .ok()?
+        .resize_to_fill(ART_SIDE, ART_SIDE, image::imageops::FilterType::Triangle)
+        .into_rgba8();
+    std::io::stdout().write_all(image.as_raw()).ok()?;
+    Some(())
+}
