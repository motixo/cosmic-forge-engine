+// SPDX-License-Identifier: GPL-3.0-only
+
+use cosmic_config::cosmic_config_derive::CosmicConfigEntry;
+use cosmic_config::CosmicConfigEntry;
+use serde::{Deserialize, Serialize};
+use std::path::PathBuf;
+
+pub const APP_ID: &str = "com.system76.CosmicLockscreen";
+
+/// A missing wallpaper follows the desktop, including per-output backgrounds.
+#[derive(Debug, Clone, Default, PartialEq, CosmicConfigEntry, Deserialize, Serialize)]
+#[version = 1]
+#[id = "com.system76.CosmicLockscreen"]
+pub struct Config {
+    pub wallpaper: Option<PathBuf>,
+}
+
+impl Config {
+    pub fn config() -> Result<cosmic_config::Config, cosmic_config::Error> {
+        cosmic_config::Config::new(APP_ID, Self::VERSION)
+    }
+}
